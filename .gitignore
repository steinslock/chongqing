__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large generated array dumps stay out of git; metrics, reports,
# predictions, manifests, and small model artifacts are kept.
*.npy
*.npz

# Large/intermediate Goal2.6 face feature dumps exceed GitHub's file limit.
artifacts/goal2_6/face/*_signal_features*.csv
artifacts/goal2_6/face/*.part.csv

# Goal2.7 release policy: keep reproducible summaries and compressed OOF
# archives in Git; keep large/regenerable visual features and checkpoints local.
artifacts/goal2_7/**/*.part.csv
artifacts/goal2_7/face/*_signal_features*.csv

# Contact sheets contain identifiable source-video frames and are local audit
# material only. Their aggregate counts remain in reports and manifests.
artifacts/goal2_7/face/contact_sheets/

# Full Goal2.7 OOF CSVs exceed GitHub's per-file limit. Deterministic .csv.gz
# release archives with the same rows are tracked instead.
results/goal2_7/all_oof_predictions_standard_cv.csv
results/goal2_7/all_oof_predictions_group_cv.csv

# Goal2.8 follows the same policy: compressed OOF archives and every metric,
# report and manifest are tracked; the uncompressed OOF CSVs exceed GitHub's
# per-file limit and the ERP/embedding arrays are large and regenerable.
results/goal2_8/all_oof_predictions_standard_cv.csv
results/goal2_8/all_oof_predictions_group_cv.csv

# Goal2.9 follows the same policy.
results/goal2_9/all_oof_predictions_standard_cv.csv
results/goal2_9/all_oof_predictions_group_cv.csv

# Scratch space for landmark extraction; regenerated on demand.
artifacts/goal2_8/face/_scratch/

# Goal2.10 eye readiness: these two carry one row per recording, and a recording
# directory embeds the subject's personal name in `record_name` and `path`
# (`A02062_<name>_251105161924`). Local audit material only, and regenerable
# with scripts/audit_eye_readiness.py. Aggregate counts and every per-unit
# statistic remain in reports/eye_readiness_audit.md and the readiness summary,
# whose recording names go through chongqing_binary.eye.index.redact_record_name.
artifacts/goal2_10/readiness/recordings.csv
artifacts/goal2_10/readiness/discarded_recordings.csv

# Goal2.10 follows the Goal2.7/2.8/2.9 OOF policy: the .csv.gz release archives
# are tracked, the uncompressed CSVs exceed GitHub's per-file limit.
results/goal2_10/all_oof_predictions_standard_cv.csv
results/goal2_10/all_oof_predictions_group_cv.csv

# Goal3 follows the same OOF policy: the .csv.gz release archive is tracked, the
# uncompressed CSV exceeds GitHub's per-file limit. The 167 MB of per-job files
# it is assembled from are regenerable with scripts/run_goal3.py and stay local,
# as do the single-trial cache and the out-of-fold embedding dumps used by the
# acquisition-group probe.
results/goal3/all_oof_predictions.csv
results/goal3/jobs/

# LaTeX. Each report lives in its own folder under reports/latex/ with a
# build/ subdirectory. The compiled PDF in build/ is tracked; everything else
# latexmk or the editor produces is regenerable and is not.
reports/latex/*/*.aux
reports/latex/*/*.fdb_latexmk
reports/latex/*/*.fls
reports/latex/*/*.log
reports/latex/*/*.out
reports/latex/*/*.pdf
reports/latex/*/*.synctex.gz
reports/latex/*/*.tex.bak
reports/latex/*/*.toc
reports/latex/*/*.xdv
reports/latex/*/build/*.aux
reports/latex/*/build/*.fdb_latexmk
reports/latex/*/build/*.fls
reports/latex/*/build/*.log
reports/latex/*/build/*.out
reports/latex/*/build/*.synctex.gz
reports/latex/*/build/*.toc
reports/latex/*/build/*.xdv
